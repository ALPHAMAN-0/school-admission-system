# Copy to .env to override the defaults used by docker-compose.yml. Everything is optional.

# How long a seat stays held before the admission fee must be paid (seconds).
HOLD_DURATION_SECONDS=600

# Backend URL the browser uses (written into the frontend's config.js at container start).
API_BASE_URL=http://localhost:8080

# Host ports
BACKEND_PORT=8080
BACKEND_2_PORT=8081
FRONTEND_PORT=3000

# Comma-separated origins allowed to call the API, or * for any.
CORS_ALLOWED_ORIGINS=*

# Database (local Docker only; use real secrets anywhere else)
POSTGRES_DB=school_admission
POSTGRES_USER=admission
POSTGRES_PASSWORD=admission_local_only
